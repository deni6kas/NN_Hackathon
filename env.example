# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# Yandex AI Studio (Yandex Cloud Foundation Models)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Размерность вектора у text-search-doc/query — 256. Проверьте актуальное значение
# в документации, если используете другую модель.
YANDEX_EMBEDDING_DIM=256

# Импорт
NODES_CSV=nodes.csv
EDGES_CSV=edges.csv
BATCH_SIZE=500
EMBED_BATCH_SIZE=200
EMBED_MAX_WORKERS=5
VECTOR_INDEX_NAME=node_embeddings
